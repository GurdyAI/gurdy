{
  "name": "@gurdy/sdk",
  "version": "0.1.0",
  "description": "Provenance enrichment for governed agent traffic \u2014 the on-ramp to gurdy-proxy.",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/GurdyAI/gurdy.git", "directory": "sdk/typescript" },
  "homepage": "https://github.com/GurdyAI/gurdy/tree/main/sdk/typescript",
  "keywords": ["mcp", "ai-agents", "governance", "audit", "provenance"],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "browser": "./dist/src/browser.js",
      "node": "./dist/src/index.js",
      "default": "./dist/src/browser.js"
    }
  },
  "files": [
    "dist/src",
    "src",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "prepack": "cp ../../LICENSE ../../NOTICE . && npm run build",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.6"
  }
}
