{
  "name": "root mint attributes the task",
  "why": "\u00a75.9: the SDK marks the task boundary once and obtains a credential; \u00a75.5: the claim is recorded as asserted and never becomes the policy principal.",
  "steps": [
    {
      "mint": {
        "as": "root",
        "agent": "orchestrator",
        "human_actor": "alice@example.com",
        "scope": {
          "compartments": [
            "*"
          ],
          "resource_types": [
            "*"
          ],
          "actions": [
            "*"
          ],
          "purpose": "ticket-9"
        }
      }
    },
    {
      "call": {
        "txn": "root",
        "tool": "read_file",
        "args": {
          "path": "/workspace/notes.txt"
        }
      }
    }
  ],
  "expect": {
    "records": [
      {
        "action": "mcp/tools_call",
        "tool": "read_file",
        "assertion_status": "valid",
        "asserted_principal": "orchestrator",
        "asserted_human_actor": "alice@example.com",
        "lineage": [
          "orchestrator"
        ],
        "principal_prefix": "svc:",
        "action_applied": "forwarded",
        "policy_mode": "monitor",
        "answered": true
      }
    ],
    "upstream_calls": 1
  }
}
