  "kind": "wire",
  "steps": [
    {
      "call": {
        "txn": "none",
        "body": "{\"model\": \"claude-opus-4-6\", \"max_tokens\": 64, \"messages\": [{\"role\": \"user\", \"content\": \"summarise\"}]}",
        "path": "/v1/messages"
      }
